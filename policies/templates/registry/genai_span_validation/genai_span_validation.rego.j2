{#-
  Renders policies/genai_span_validation.rego in full: the per-span-type data
  tables (derived from the pinned GenAI semconv registry and the weaver.yaml
  params) followed by the fixed rule logic. Regenerate with
  `make generate-conformance-policies` after bumping SEMCONV_GENAI_REF in
  versions.env or editing the params; do not edit the output.

  Uses the weaver `--v2` resolved-registry schema: `ctx` is `.registry`, so
  `ctx.spans` is the base span groups (provider refinements live under the
  top-level `refinements` key and are excluded — the rego validates the
  baseline shape refinements inherit) and attribute names are `attr.key`. Only
  `gen_ai.*` spans are emitted (mcp.* is skipped).
-#}
{%- set prefix = "gen_ai." -%}
{#- Fail generation if a gen_ai span type is missing from the span_operations
    param: otherwise it would silently emit no operation mapping and escape
    validation entirely. minijinja has no raise() and weaver doesn't enable
    strict-undefined, so `| int` on a message string forces a hard evaluation
    error (reported as "invalid float literal" at this template line). -#}
{%- for s in ctx.spans if prefix in s.type and s.type not in params.span_operations -%}
{{- ("FATAL: span type '" ~ s.type ~ "' is not mapped in the span_operations param (weaver.yaml) — add it") | int -}}
{%- endfor -%}
{%- set ns = namespace(op_names=[]) -%}
{%- for s in ctx.spans -%}
  {%- for a in s.attributes if a.key == "gen_ai.operation.name" and a.type.members and ns.op_names == [] -%}
    {%- set ns.op_names = a.type.members | map(attribute="value") | list | sort -%}
  {%- endfor -%}
{%- endfor -%}
# AUTO-GENERATED from the GenAI semantic-conventions registry and the params in
# templates/registry/genai_span_validation/weaver.yaml. DO NOT EDIT.
# Regenerate with `make generate-conformance-policies` after bumping
# SEMCONV_GENAI_REF in versions.env or editing the params.
#
# Validates GenAI span shape beyond weaver's registry-driven per-attribute
# checks: cross-cutting span-level invariants keyed on `gen_ai.operation.name`
# (mapped to a semconv span type). The `_gen_*` attribute/kind tables come from
# the registry; `_gen_op_types` and `_gen_span_name_target` come from the
# weaver.yaml params.

package live_check_advice

import rego.v1

# ─── Generated data ─────────────────────────────────────────────────────────

# Span kind per base gen_ai span type.
{% for s in ctx.spans if prefix in s.type -%}
_gen_type_kind["{{ s.type | replace(prefix, "") }}"] := "{{ s.kind }}"
{% endfor %}
# Attribute appended to the span name (`{operation} {value}`), per span type.
# Absent for types whose name is just `{operation}` (e.g. memory).
{% for s in ctx.spans if prefix in s.type and s.type in params.span_name_target -%}
_gen_span_name_target["{{ s.type | replace(prefix, "") }}"] := "{{ params.span_name_target[s.type] }}"
{% endfor %}
# gen_ai.operation.name -> set of span-type tokens that emit it. Single-valued
# for every operation except invoke_agent (internal + client).
{% for op in ns.op_names -%}
_gen_op_types["{{ op }}"] := {{ '{' }}
{%- set sep = joiner(", ") -%}
{%- for s in ctx.spans if prefix in s.type -%}
  {%- if op in params.span_operations[s.type] -%}{{ sep() }}"{{ s.type | replace(prefix, "") }}"{%- endif -%}
{%- endfor -%}
{{ '}' }}
{% endfor %}
# Required attributes per span type (requirement_level: required).
{% for s in ctx.spans if prefix in s.type -%}
{%- set attrs = s.attributes | required | map(attribute="key") | list | sort -%}
_gen_required["{{ s.type | replace(prefix, "") }}"] := {% if attrs %}{{ '{' }}{% for a in attrs %}"{{ a }}"{{ ", " if not loop.last }}{% endfor %}{{ '}' }}{% else %}set(){% endif %}
{% endfor %}
# Unconditionally recommended attributes per span type (requirement_level is the
# plain string `recommended`, not the `{recommended: <note>}` conditional form
# nor opt_in). Semconv recommends these on every span of the type, so a missing
# one is a violation — same tier as Required. The conditional forms
# (`{recommended: …}`, `{conditionally_required: …}`) are excluded here.
{% for s in ctx.spans if prefix in s.type -%}
{%- set attrs = s.attributes | selectattr("requirement_level", "equalto", "recommended") | map(attribute="key") | list | sort -%}
_gen_recommended["{{ s.type | replace(prefix, "") }}"] := {% if attrs %}{{ '{' }}{% for a in attrs %}"{{ a }}"{{ ", " if not loop.last }}{% endfor %}{{ '}' }}{% else %}set(){% endif %}
{% endfor %}
# Conditionally-expected attributes per span type: requirement_level is an object
# form — `{recommended: <note>}` or `{conditionally_required: <note>}` — so the
# attribute belongs on the span only when the note's condition holds. The policy
# can't evaluate the condition, so a missing one is surfaced at `information`
# level, not flagged. The three plain-string forms (required/recommended/opt_in)
# are excluded here; error.type is excluded too (its status-conditional presence
# is checked by the dedicated error.type rules).
{% for s in ctx.spans if prefix in s.type -%}
{%- set attrs = s.attributes | rejectattr("requirement_level", "equalto", "required") | rejectattr("requirement_level", "equalto", "recommended") | rejectattr("requirement_level", "equalto", "opt_in") | rejectattr("key", "equalto", "error.type") | map(attribute="key") | list | sort -%}
_gen_conditional["{{ s.type | replace(prefix, "") }}"] := {% if attrs %}{{ '{' }}{% for a in attrs %}"{{ a }}"{{ ", " if not loop.last }}{% endfor %}{{ '}' }}{% else %}set(){% endif %}
{% endfor %}
# Recommended attributes that are only set when the caller/provider supplies a
# value (from the `recommended_optional` param); never flagged. See weaver.yaml.
{% for s in ctx.spans if prefix in s.type and s.type in params.recommended_optional -%}
_gen_recommended_optional["{{ s.type | replace(prefix, "") }}"] := {{ '{' }}{% for a in params.recommended_optional[s.type] %}"{{ a }}"{{ ", " if not loop.last }}{% endfor %}{{ '}' }}
{% endfor %}
# Recommended attributes that must appear on a successful span (from the
# `recommended_on_success` param); flagged only when status != error. See weaver.yaml.
{% for s in ctx.spans if prefix in s.type and s.type in params.recommended_on_success -%}
_gen_recommended_on_success["{{ s.type | replace(prefix, "") }}"] := {{ '{' }}{% for a in params.recommended_on_success[s.type] %}"{{ a }}"{{ ", " if not loop.last }}{% endfor %}{{ '}' }}
{% endfor %}
# All documented gen_ai.operation.name enum values.
_gen_operation_names := {{ '{' }}{% for op in ns.op_names %}"{{ op }}"{{ ", " if not loop.last }}{% endfor %}{{ '}' }}
{% raw %}
# ─── Span-type resolution ───────────────────────────────────────────────────
#
# Map a sample's `gen_ai.operation.name` (+ span kind) to the semconv span-type
# token the tables above are keyed on. Most operations map to a single span
# type (kind ignored); `invoke_agent` maps to two (internal + client), so it
# dispatches on kind. Undefined for an unknown op.

_span_type_for(op, _) := span_type if {
	types := _gen_op_types[op]
	count(types) == 1
	some span_type in types
}

_span_type_for(op, kind) := span_type if {
	types := _gen_op_types[op]
	count(types) > 1
	some span_type in types
	_gen_type_kind[span_type] == kind
}

# ─── Span name format (violation) ───────────────────────────────────────────
#
# Span name SHOULD be `{op}` (when the keyed attribute is absent) or
# `{op} {value}` (when present). A span type absent from
# `_gen_span_name_target` (e.g. memory) is not name-checked.
#
# Avoid `%v ` patterns in sprintf: weaver 0.22.1's OPA-based sprintf consumes a
# single space character immediately following any verb (`%v`, `%s`, `%d`) —
# interpreting it as Go's space-flag — so `%v %v` produces `<a><b>` instead of
# `<a> <b>`. We use `concat` for the literal-space joins below.
deny contains _span_finding(
	"genai_span_name_format",
	"violation",
	input.sample.span,
	{
		"operation": op,
		"target": target,
		"expected_form": concat("", [op, " or '", op, " <", target, ">'"]),
	},
	concat("", [
		op, " span name should be '",
		op, "' or '",
		op, " <value of ", target, ">', got '",
		input.sample.span.name, "'",
	]),
) if {
	input.sample.span
	op := _attr_value(input.sample.span, "gen_ai.operation.name")
	span_type := _span_type_for(op, input.sample.span.kind)
	target := _gen_span_name_target[span_type]
	not _valid_op_and_attr_span_name(input.sample.span, op, target)
}

# ─── Per-span-type expected attributes (violation) ──────────────────────────

# Recommended attributes split into three buckets the registry can't express
# (the split is curated in weaver.yaml):
#   * optional (`recommended_optional`) — recommended unconditionally by semconv
#     but only set when the caller/provider supplies a value (sampling parameters,
#     prompt-cache token counts, encoding formats). Never flagged.
#   * on-success (`recommended_on_success`) — must be present on a successful
#     span, excused on an error span (response finish reasons, usage token
#     counts). Flagged as a violation only when status != error.
#   * everything else recommended (server.address, response.model, …) — flagged
#     whenever missing.
# Conditional forms (`{recommended: …}`, `{conditionally_required: …}`) are in
# `_gen_conditional` and surfaced at `information` level instead.
_recommended_optional(span_type) := _gen_recommended_optional[span_type]

_recommended_optional(span_type) := set() if not _gen_recommended_optional[span_type]

_recommended_on_success(span_type) := _gen_recommended_on_success[span_type]

_recommended_on_success(span_type) := set() if not _gen_recommended_on_success[span_type]

# Always-expected = Required ∪ (Recommended minus the optional and on-success
# buckets). Missing one is a violation regardless of span status.
_expected_attrs(span_type) := _gen_required[span_type] | (_gen_recommended[span_type] - (_recommended_optional(span_type) | _recommended_on_success(span_type)))

# Per always-expected attribute, one violation if missing.
deny contains _span_finding(
	"genai_expected_attribute_missing",
	"violation",
	input.sample.span,
	{
		"operation": op,
		"missing_attribute": attr_name,
	},
	sprintf(
		"Span '%v' (operation '%v') is missing expected attribute '%v'",
		[input.sample.span.name, op, attr_name],
	),
) if {
	input.sample.span
	op := _attr_value(input.sample.span, "gen_ai.operation.name")
	span_type := _span_type_for(op, input.sample.span.kind)
	some attr_name in _expected_attrs(span_type)
	not _has_attr(input.sample.span, attr_name)
}

# On-success attributes: a successful span (status != error) must carry them; an
# error span is excused (a failed call may produce no response/usage).
deny contains _span_finding(
	"genai_expected_attribute_missing",
	"violation",
	input.sample.span,
	{
		"operation": op,
		"missing_attribute": attr_name,
	},
	sprintf(
		"Span '%v' (operation '%v') completed successfully but is missing expected attribute '%v'",
		[input.sample.span.name, op, attr_name],
	),
) if {
	input.sample.span
	input.sample.span.status.code != "error"
	op := _attr_value(input.sample.span, "gen_ai.operation.name")
	span_type := _span_type_for(op, input.sample.span.kind)
	some attr_name in _recommended_on_success(span_type)
	not _has_attr(input.sample.span, attr_name)
}

# ─── Per-span-type conditional attributes (information) ──────────────────────
#
# Attributes semconv marks conditionally — `{recommended: <note>}` or
# `{conditionally_required: <note>}` (`_gen_conditional`) — belong on a span only
# when the note's condition holds, which the policy can't evaluate. A missing one
# is surfaced at `information` level (never fails a build) so the gap is visible
# without being enforced. error.type is handled by the dedicated rules below.

deny contains _span_finding(
	"genai_conditional_attribute_missing",
	"information",
	input.sample.span,
	{
		"operation": op,
		"missing_attribute": attr_name,
	},
	sprintf(
		"Span '%v' (operation '%v') is missing conditionally-expected attribute '%v'; set it when semconv's condition applies",
		[input.sample.span.name, op, attr_name],
	),
) if {
	input.sample.span
	op := _attr_value(input.sample.span, "gen_ai.operation.name")
	span_type := _span_type_for(op, input.sample.span.kind)
	some attr_name in _gen_conditional[span_type]
	not _has_attr(input.sample.span, attr_name)
}

# ─── Per-operation span kind (violation) ────────────────────────────────────
#
# Semconv pins the span kind for each span type (`_gen_type_kind`). An
# operation's allowed kinds are the kinds of every span type it maps to
# (`invoke_agent` allows both internal and client). A span whose kind is
# outside that set is flagged. Undefined (→ no violation) for unmapped ops.
_expected_kinds_for_op(op) := {kind |
	some span_type in _gen_op_types[op]
	kind := _gen_type_kind[span_type]
}

deny contains _span_finding(
	"genai_span_kind_unexpected",
	"violation",
	input.sample.span,
	{
		"operation": op,
		"kind": input.sample.span.kind,
	},
	sprintf(
		"Span '%v' (operation '%v') has kind '%v'; semconv expects one of %v",
		[input.sample.span.name, op, input.sample.span.kind, sorted_kinds],
	),
) if {
	input.sample.span
	op := _attr_value(input.sample.span, "gen_ai.operation.name")
	expected_kinds := _expected_kinds_for_op(op)
	count(expected_kinds) > 0
	not expected_kinds[input.sample.span.kind]
	sorted_kinds := sort([k | some k in expected_kinds])
}

# ─── Unknown gen_ai.operation.name (violation) ──────────────────────────────
#
# Weaver's built-in `undefined_enum_variant` advice is `information`-level;
# we raise unknown values on `gen_ai.operation.name` to a violation.
# `_gen_operation_names` is generated from the registry enum.

deny contains _span_finding(
	"genai_operation_name_unknown",
	"violation",
	input.sample.span,
	{"operation": op},
	sprintf(
		"Span '%v' has gen_ai.operation.name='%v' which is not a documented enum value",
		[input.sample.span.name, op],
	),
) if {
	input.sample.span
	op := _attr_value(input.sample.span, "gen_ai.operation.name")
	not _gen_operation_names[op]
}

# ─── Span status (violation) ────────────────────────────────────────────────
#
# Per the OpenTelemetry trace spec, instrumentation libraries MUST NOT set span
# status to OK — that value is reserved for application code that has explicitly
# verified the call succeeded. Instrumentations should leave status UNSET on
# success and set ERROR on failure.
# https://opentelemetry.io/docs/specs/otel/trace/api/#set-status

deny contains _span_finding(
	"genai_span_status_ok_set_by_instrumentation",
	"violation",
	input.sample.span,
	{"status_code": input.sample.span.status.code},
	sprintf(
		"Span '%v' has status.code='ok'; instrumentations must leave status UNSET on success (OK is reserved for application code).",
		[input.sample.span.name],
	),
) if {
	input.sample.span
	input.sample.span.status.code == "ok"
}

# ─── error.type on failure (violation) ──────────────────────────────────────
#
# Semconv requires `error.type` to be set when an operation fails. The registry
# can't express this — it's conditional on span status — so check both
# directions: an error span MUST carry error.type, and error.type MUST NOT
# appear on a non-error span.

deny contains _span_finding(
	"genai_error_type_missing_on_error",
	"violation",
	input.sample.span,
	{"status_code": input.sample.span.status.code},
	sprintf(
		"Span '%v' has status.code='error' but is missing 'error.type'; it MUST be set when the operation fails.",
		[input.sample.span.name],
	),
) if {
	input.sample.span
	input.sample.span.status.code == "error"
	not _has_attr(input.sample.span, "error.type")
}

deny contains _span_finding(
	"genai_error_type_without_error_status",
	"violation",
	input.sample.span,
	{"status_code": input.sample.span.status.code},
	sprintf(
		"Span '%v' sets 'error.type'='%v' but status.code is '%v', not 'error'.",
		[input.sample.span.name, _attr_value(input.sample.span, "error.type"), input.sample.span.status.code],
	),
) if {
	input.sample.span
	_has_attr(input.sample.span, "error.type")
	input.sample.span.status.code != "error"
}

# ─── Helpers ────────────────────────────────────────────────────────────────

# Span attributes arrive as `[{"name": ..., "value": ..., "type": ...}]`.

# True when the span has an attribute named `name`.
_has_attr(span, name) if {
	some attr in span.attributes
	attr.name == name
}

# Returns the value of the named attribute. Undefined (rule body fails) when the
# attribute isn't present — callers must guard with `_has_attr` first if they
# need to distinguish "absent" from "set to a falsy value".
_attr_value(span, name) := value if {
	some attr in span.attributes
	attr.name == name
	value := attr.value
}

# A valid span name is either exactly `{op}` (when the keyed attribute is
# absent) or `{op} {value}` (when present).
_valid_op_and_attr_span_name(span, op, attr_key) if {
	span.name == op
	not _has_attr(span, attr_key)
}

_valid_op_and_attr_span_name(span, op, attr_key) if {
	value := _attr_value(span, attr_key)
	# concat (not sprintf): see the note above the deny rule. sprintf("%v %v", ...)
	# silently produces "<a><b>" with no space, so every span with a `{op} {value}`
	# name would be reported as a violation.
	span.name == concat(" ", [op, value])
}

# PolicyFinding format per
# https://github.com/open-telemetry/weaver/blob/main/crates/weaver_live_check/README.md#policyfinding
_span_finding(id, level, span, context, message) := {
	"id": id,
	"level": level,
	"signal_type": "span",
	"signal_name": span.name,
	"context": context,
	"message": message,
}
{% endraw %}
